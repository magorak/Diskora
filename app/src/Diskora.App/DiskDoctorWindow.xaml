<Window x:Class="Diskora.App.DiskDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:Diskora.App.Converters"
        mc:Ignorable="d"
        Title="Disk Doctor" Height="640" Width="820" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/AppIcon.ico">

    <Window.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrushConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Subject}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="1" Content="Zkontrolovat znovu" VerticalAlignment="Top"
                    Command="{Binding RunCommand}" />
        </Grid>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" Margin="0,0,0,12"
                     AutomationProperties.Name="Probíhá kontrola disku"
                     Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border Grid.Row="1"
                Background="{DynamicResource DangerBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" CornerRadius="6" Padding="14" Margin="0,0,0,16"
                Background="{Binding Overall, Converter={StaticResource RiskToBrushConverter}}"
                Visibility="{Binding HasRun, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding OverallDisplay}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding VerdictText}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Zjištění kontroly disku">
                <ItemsControl ItemsSource="{Binding Findings}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Margin="0,2,12,0" Padding="6,2" CornerRadius="3"
                                        VerticalAlignment="Top" MinWidth="72"
                                        Background="{Binding Severity, Converter={StaticResource RiskToBrushConverter}}">
                                    <TextBlock Text="{Binding SeverityDisplay}" Foreground="White" FontSize="11"
                                               HorizontalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>

                                <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top"
                                        Content="{Binding ActionButtonText}" Tag="{Binding}"
                                        Click="Action_Click"
                                        Visibility="{Binding HasActionButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
