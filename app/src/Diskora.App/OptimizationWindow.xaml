<Window x:Class="Diskora.App.OptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:Diskora.App.Converters"
        mc:Ignorable="d"
        Title="Optimalizace disku" Height="560" Width="760" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/AppIcon.ico">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding VolumeName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Znovu zjistit typ disku" Command="{Binding RefreshCapabilitiesCommand}" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="{Binding CapabilitiesSummary}" Foreground="White" TextWrapping="Wrap" />
                <TextBlock Text="{Binding UnknownTypeWarning}" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding ShowUnknownTypeWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Margin="0,0,8,0" Content="Spustit TRIM"
                    Command="{Binding RunTrimCommand}"
                    Visibility="{Binding ShowTrimAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="0" Margin="0,0,8,0" Content="Spustit defragmentaci"
                    Command="{Binding RunDefragmentCommand}"
                    Visibility="{Binding ShowDefragAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="1" Margin="0,0,8,0" Content="Analyzovat fragmentaci"
                    Command="{Binding AnalyzeFragmentationCommand}" Click="AnalyzeFragmentation_Click"
                    Visibility="{Binding ShowDefragAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="2" Margin="0,0,8,0" Content="Zrušit" Command="{Binding CancelCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Grid.Column="3" Content="Zrušit analýzu" Command="{Binding CancelFragmentationCommand}"
                    Visibility="{Binding IsAnalyzingFragmentation, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Grid.Column="4" Text="{Binding OperationSummary}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,0,0,12" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                   Text="TRIM (retrim) i defragmentace vyžadují práva administrátora. Když je typ disku známý, Diskora nabídne jen akci, která pro něj dává smysl." />

        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}">
            <TabControl x:Name="Tabs">
                <TabItem Header="Výstup">
                  <DockPanel>
                    <CheckBox DockPanel.Dock="Top" Margin="8,8,8,4" HorizontalAlignment="Right"
                              Content="Zobrazit původní anglický výstup nástroje"
                              IsChecked="{Binding ShowRawOutput}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DisplayedOutputLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                </TabItem>

                <TabItem x:Name="FragmentationTab" Header="Fragmentace"
                         Visibility="{Binding ShowDefragAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{Binding FragmentationSummary}"
                                   Visibility="{Binding HasAnalyzedFragmentation, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding FragmentationStatusText}"
                                   Visibility="{Binding IsAnalyzingFragmentation, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding MostFragmentedFiles}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Soubor" Binding="{Binding FullPath}" Width="*" />
                                <DataGridTextColumn Header="Velikost" Binding="{Binding SizeDisplay}" Width="110" />
                                <DataGridTextColumn Header="Fragmentů" Binding="{Binding FragmentCountDisplay}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
