<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1C1E21" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E4E8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E5E7EB" />

    <!--
        Kategoriální paleta pro grafy (skill dataviz - referenční ověřená paleta,
        pevné pořadí odstínů, ne cyklované). Pátý+ podíl se skládá do "Ostatní"
        pomocí MutedForegroundBrush výše.
    -->
    <SolidColorBrush x:Key="SeriesBrush1" Color="#2A78D6" />
    <SolidColorBrush x:Key="SeriesBrush2" Color="#EB6834" />
    <SolidColorBrush x:Key="SeriesBrush3" Color="#1BAF7A" />
    <SolidColorBrush x:Key="SeriesBrush4" Color="#EDA100" />
    <SolidColorBrush x:Key="SeriesBrush5" Color="#E87BA4" />

    <!-- Sekvenční modrá (velikost/magnituda) pro treemapu zaplněnosti - jedna barva,
         světlá/tmavá dle podílu (viz skill dataviz - sequential, ne kategoriální,
         protože buňky treemapy nejsou pojmenované kategorie). Nejsvětlejší krok
         zůstává nad prahem 2:1 vůči podkladu, aby i nejmenší buňka byla vidět. -->
    <SolidColorBrush x:Key="TreemapCellLowBrush" Color="#86B6EF" />
    <SolidColorBrush x:Key="TreemapCellHighBrush" Color="#0D366B" />

    <!--
        Windows odvozuje výchozí (nestylované) části vestavěných ovládacích prvků
        (DataGridRow, Menu, ScrollBar, ...) z těchto systémových barev. Pokud je
        v OS zapnutý tmavý režim, bez tohoto přepisu by tyto části zůstaly tmavé,
        i když je aplikace explicitně ve světlém tématu - to způsobovalo černé
        panely na bílém pozadí. Přepsáním sjednotíme veškerý výchozí chrome
        s naší paletou.
    -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#1C1E21" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F5F6F8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#E2E4E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#C7CAD1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1C1E21" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9AA0AC" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2563EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#D9E2FB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1C1E21" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1C1E21" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#2563EB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#E2E4E8" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#E2E4E8" />

</ResourceDictionary>
