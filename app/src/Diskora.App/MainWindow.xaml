<Window x:Class="Diskora.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diskora.App"
        xmlns:conv="clr-namespace:Diskora.App.Converters"
        mc:Ignorable="d"
        Title="Diskora" Height="760" Width="1280" MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <conv:DiskMediaTypeToBrushConverter x:Key="DiskMediaTypeToBrushConverter" />
        <conv:DiskMediaTypeToIconConverter x:Key="DiskMediaTypeToIconConverter" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Soubor">
                <MenuItem Header="_Obnovit disky" Command="{Binding RefreshCommand}" InputGestureText="Ctrl+R" />
                <MenuItem Header="_Analyzovat složku..." Click="AnalyzeFolder_Click" />
                <MenuItem Header="O_tevřít virtuální disk / ISO (VHD/VHDX/ISO)..." Click="OpenVirtualDisk_Click" />
                <Separator />
                <MenuItem Header="_Konec" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Zobrazit">
                <MenuItem Header="Světlé" IsCheckable="True" IsChecked="{Binding IsLightThemeActive, Mode=OneWay}" Command="{Binding SetLightThemeCommand}" />
                <MenuItem Header="Tmavé" IsCheckable="True" IsChecked="{Binding IsDarkThemeActive, Mode=OneWay}" Command="{Binding SetDarkThemeCommand}" />
                <MenuItem Header="Podle systému" IsCheckable="True" IsChecked="{Binding IsSystemThemeActive, Mode=OneWay}" Command="{Binding SetSystemThemeCommand}" />
            </MenuItem>
            <MenuItem Header="Nás_troje">
                <MenuItem Header="_Systémový protokol (disky)..." Click="ShowSystemEventLog_Click" />
                <Separator />
                <MenuItem Header="N_astavení..." Click="ShowSettings_Click" />
            </MenuItem>
            <MenuItem Header="_Nápověda">
                <MenuItem Header="_Co je nového..." Click="ShowWhatsNew_Click" />
                <Separator />
                <MenuItem Header="_O aplikaci Diskora" Click="ShowAbout_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Diskora" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="{Binding ElevationStatusText}" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="Obnovit" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource DangerBrush}"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Fyzické disky" Style="{StaticResource HeadingTextStyle}" />
                    <DataGrid ItemsSource="{Binding PhysicalDisks}" VirtualizingPanel.ScrollUnit="Item">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40" />
                            <DataGridTextColumn Header="Název" Binding="{Binding FriendlyName}" Width="*" />
                            <DataGridTextColumn Header="Velikost" Binding="{Binding SizeDisplay}" Width="110" />
                            <DataGridTemplateColumn Header="Typ" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{Binding MediaType, Converter={StaticResource DiskMediaTypeToIconConverter}}"
                                                  Stroke="{Binding MediaType, Converter={StaticResource DiskMediaTypeToBrushConverter}}"
                                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" Fill="Transparent"
                                                  Width="18" Height="18" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding MediaTypeDisplay}" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rozhraní" Binding="{Binding BusTypeDisplay}" Width="120" />
                            <DataGridTextColumn Header="Sériové číslo" Binding="{Binding SerialNumberDisplay}" Width="170" />
                            <DataGridTemplateColumn Header="Akce" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="S.M.A.R.T." Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                    Click="ShowSmart_Click" Tag="{Binding}" />
                                            <Button Content="Povrchový sken" Padding="8,3" FontSize="11"
                                                    Click="ShowSurfaceScan_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Svazky" Style="{StaticResource HeadingTextStyle}" />
                    <DataGrid ItemsSource="{Binding Volumes}" VirtualizingPanel.ScrollUnit="Item">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Jednotka" Binding="{Binding Name}" Width="72" />
                            <DataGridTextColumn Header="Název" Binding="{Binding Label}" Width="*" MinWidth="80" />
                            <DataGridTextColumn Header="Systém souborů" Binding="{Binding FileSystem}" Width="105" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding DriveTypeDisplay}" Width="90" />
                            <DataGridTemplateColumn Header="Typ disku" Width="92">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{Binding DiskMediaType, Converter={StaticResource DiskMediaTypeToIconConverter}}"
                                                  Stroke="{Binding DiskMediaType, Converter={StaticResource DiskMediaTypeToBrushConverter}}"
                                                  StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" Fill="Transparent"
                                                  Width="17" Height="17" Stretch="Uniform" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding DiskMediaTypeDisplay}" VerticalAlignment="Center" FontSize="12" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Zaplněnost" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}"
                                                     Minimum="0" Maximum="100"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="{Binding UsedPercent, StringFormat='Zaplněnost {0:F0} procent'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Volno" Binding="{Binding FreeSpaceDisplay}" Width="85" />
                            <DataGridTextColumn Header="Celkem" Binding="{Binding TotalSizeDisplay}" Width="85" />
                            <DataGridTemplateColumn Header="Akce" Width="450">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Disk Doctor" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                    FontWeight="SemiBold"
                                                    Click="ShowDiskDoctor_Click" Tag="{Binding}" />
                                            <Button Content="Zkontrolovat" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                    Click="ShowIntegrity_Click" Tag="{Binding}" />
                                            <Button Content="Analyzovat" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                    Click="ShowDiskUsage_Click" Tag="{Binding}" />
                                            <Button Content="Optimalizovat" Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                                    Click="ShowOptimization_Click" Tag="{Binding}" />
                                            <Button Content="Test kapacity" Padding="8,3" FontSize="11"
                                                    ToolTip="Ověří, že disk skutečně pojme to, co tvrdí - odhalí přeznačené flash disky."
                                                    Click="ShowCapacityTest_Click" Tag="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
