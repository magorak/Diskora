<Window x:Class="Diskora.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Nastavení" Height="320" Width="480" MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Assets/AppIcon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nastavení" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Upozornit na zhoršení zdraví disku od úrovně:" Margin="0,0,0,6" />
            <ComboBox x:Name="ThresholdComboBox" HorizontalAlignment="Left" MinWidth="220"
                      AutomationProperties.Name="Práh upozornění na zhoršení zdraví disku">
                <ComboBoxItem Content="Varování a horší (výchozí)" Tag="Warning" />
                <ComboBoxItem Content="Jen kritické" Tag="Critical" />
            </ComboBox>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                       Text="Týká se tray upozornění na pozadí (viz Fáze 2/7) - platí až po restartu Diskory." />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="PromptForElevationCheckBox"
                      Content="Při startu bez práv administrátora nabídnout restart s elevací"
                      AutomationProperties.Name="Při startu bez práv administrátora nabídnout restart s elevací" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                       Text="Výchozí volba dialogu bude „Ne“ - Diskora nikoho nenutí do UAC promptu omylem." />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Zrušit" Padding="14,4" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Uložit" Padding="14,4" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
